{
  "name": "bear-downloader",
  "displayName": "Bear Downloader",
  "version": "1.0.0",
  "description": "Cordova webview app with downloader, TTS, pull-to-refresh navbar, and desktop mode.",
  "main": "www/index.html",
  "author": "BearAi",
  "license": "MIT",
  "scripts": {
    "build:android": "cordova platform add android && cordova build android",
    "build:debug": "cordova build android --debug",
    "build:release": "cordova build android --release"
  },
  "dependencies": {
    "cordova-android": "^11.0.0",
    "cordova-plugin-file": "^8.0.0",
    "cordova-plugin-file-transfer": "^2.0.0",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-statusbar": "^3.0.0",
    "cordova-plugin-whitelist": "^1.3.3"
  },
  "devDependencies": {
    "cordova": "^12.0.0"
  },
  "keywords": [
    "cordova",
